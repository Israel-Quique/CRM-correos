# Base de datos
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/crm_integrador
DATABASE_SSL=false

# API local
PORT=3001
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
JSON_BODY_LIMIT=1mb

# Usuario administrador inicial opcional
# Solo se crea si ambos valores estan definidos; no sobrescribe usuarios existentes.
SEED_ADMIN_NAME=Admin General
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambia_esta_contrasena_segura
ENABLE_DEMO_LOGIN=false
DEMO_USER_EMAIL=admin@example.com

# WhatsApp Meta Cloud API
# 1) Access token permanente generado en Meta Developers / WhatsApp
WHATSAPP_META_ACCESS_TOKEN=pega_aqui_tu_access_token_permanente
# 2) Phone Number ID del numero de WhatsApp Business conectado
WHATSAPP_META_PHONE_NUMBER_ID=pega_aqui_tu_phone_number_id
# 3) WhatsApp Business Account ID
WHATSAPP_META_BUSINESS_ACCOUNT_ID=pega_aqui_tu_business_account_id
# 4) Version del Graph API
WHATSAPP_META_API_VERSION=v23.0
# 5) Numero remitente aprobado en Meta
WHATSAPP_META_SENDER_NUMBER=+59170000000
# 6) Token para validar el webhook
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=crmwebhooktoken15988785

# IA local con Docker (Ollama)
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_GENERAL_MODEL=qwen2.5:7b
AI_ROUTER_MODEL=qwen2.5:0.5b
AI_TRACKING_MODEL=llama3.2:3b
AI_AUTO_REPLY=true
WHATSAPP_TEST_MODE_NUMBER=+59170000000
WHATSAPP_TEST_MODE=false
WHATSAPP_AUTO_START_ON_DASHBOARD=false
WHATSAPP_STAGE_WATCHER_ENABLED=false
WHATSAPP_NEW_PACKAGE_WATCHER_ENABLED=false
WHATSAPP_NEW_PACKAGE_WELCOME_ENABLED=false
WHATSAPP_PACKAGE_WATCHER_TEST_MODE_RESTRICTED=false
PACKAGE_PIPELINE_SYNC_INTERVAL_MS=300000
PACKAGE_NEW_PACKAGE_WELCOME_INTERVAL_MS=300000
PACKAGE_EVENT_CHANGE_SYNC_INTERVAL_MS=60000
PACKAGE_FULL_EVENT_CHANGE_SYNC_INTERVAL_MS=900000
PACKAGE_EVENTS_LOOKUP_CONCURRENCY=3

# Tracking externo
TRACKING_SQLSERVER_TOKEN=pega_aqui_tu_token_de_tracking
TRACKING_API_URL=https://dev.correos.gob.bo:18100
TRACKING_API_FALLBACK_URL=http://172.65.10.55:8103

# Paquetes de contactos externos
PAQUETES_CONTACTOS_API_URL=https://dev.correos.gob.bo:18100/api/paquetes-contactos
PAQUETES_CONTACTOS_API_TOKEN=pega_aqui_tu_token_de_paquetes_contactos

# Eventos de paquetes externos
PAQUETES_EVENTOS_API_URL=http://dev.correos.gob.bo:18100/api/paquetes-eventos
PAQUETES_EVENTOS_API_TOKEN=pega_aqui_tu_token_de_eventos

# Tarifarios externos
DELIVERY_EXPRESS_TARIFF_API_URL=https://dev.correos.gob.bo:18100/api/tarifarios/delivery-express
DELIVERY_EXPRESS_TARIFF_API_TOKEN=pega_aqui_tu_token_de_delivery_express
EMS_NATIONAL_TARIFF_API_URL=https://dev.correos.gob.bo:18100/api/tarifarios/ems-nacional
EMS_NATIONAL_TARIFF_API_TOKEN=pega_aqui_tu_token_de_ems_nacional
# CalcuPost: endpoint POST /api/calcular; configurable para cada entorno.
EMS_CALCULATOR_API_URL=https://postar.correos.gob.bo/api/calcular
