# Base de datos
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/crm_integrador
DATABASE_SSL=false

# API local
PORT=3001
VITE_API_URL=http://localhost:3001

# WhatsApp Meta Cloud API
# 1) Access token permanente generado en Meta Developers / WhatsApp
WHATSAPP_META_ACCESS_TOKEN=pega_aqui_tu_access_token_permanente
# 2) Phone Number ID del numero de WhatsApp Business conectado
WHATSAPP_META_PHONE_NUMBER_ID=pega_aqui_tu_phone_number_id
# 3) WhatsApp Business Account ID
WHATSAPP_META_BUSINESS_ACCOUNT_ID=pega_aqui_tu_business_account_id
# 4) Version del Graph API
WHATSAPP_META_API_VERSION=v23.0
# 5) Numero remitente aprobado en Meta
WHATSAPP_META_SENDER_NUMBER=+59170000000
# 6) Token para validar el webhook
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=pega_aqui_tu_webhook_verify_token

# IA local con Docker (Ollama)
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_GENERAL_MODEL=qwen2.5:7b
AI_ROUTER_MODEL=qwen2.5:0.5b
AI_TRACKING_MODEL=llama3.2:3b
AI_AUTO_REPLY=true
WHATSAPP_STAGE_WATCHER_ENABLED=true
WHATSAPP_STAGE_WATCHER_INTERVAL_MS=30000

# Tracking externo
TRACKING_SQLSERVER_TOKEN=pega_aqui_tu_token_de_tracking
TRACKING_API_URL=https://dev.correos.gob.bo:18100

# Paquetes de contactos externos
PAQUETES_CONTACTOS_API_URL=https://dev.correos.gob.bo:18100/api/paquetes-contactos
PAQUETES_CONTACTOS_API_TOKEN=pega_aqui_tu_token_de_paquetes_contactos
