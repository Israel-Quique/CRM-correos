    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "flag-icons": "^7.5.0",
    "libphonenumber-js": "^1.13.11",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
